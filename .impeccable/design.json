  "narrative": {
    "northStar": "Work routes",
    "overview": "A minimal operating canvas makes real tasks, responsible parties and prerequisites visible together. Cool neutrals, softly elevated nodes and compact Geist typography give the graph room; owner-selected tints identify responsibility without colouring the text. The user rejected brutalism, decorative rules and explanatory dashboard filler.\n\nThe workspace theme is local to the graph and its themed editing/management surfaces. Statistics keeps its existing warm mineral-glass presentation; Connections, API access, API documentation and authentication keep the shared warm editorial foundation. This document captures those boundaries rather than prescribing a whole-app reskin.",
    "keyCharacteristics": [
      "Actual directed dependencies and project lanes.",
      "Readable native-scale entry, with an explicit overview control.",
      "Quiet chrome, dynamic owner colours and full-contrast task text.",
      "Persistent drafts and graph context during background synchronization."
    ],
    "rules": [
      {
        "name": "Context before colour",
        "body": "Owner tint supplements the written assignee and state; completed tasks keep full-opacity text.",
        "section": "colors"
      },
      {
        "name": "Readable entry",
        "body": "Open the graph at scale 1, including constrained desktops and phones; Fit is the explicit full-graph overview. The project, responsible-party and refresh-interval selectors keep their accessible labels visually hidden at every viewport width.",
        "section": "typography"
      },
      {
        "name": "Scoped materials",
        "body": "Opaque graph surfaces and retained Statistics glass coexist; do not spread either treatment to unrelated routes.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use HeroUI v3 compound primitives and Tailwind CSS 4, with existing Geist fonts.",
      "Do render stored projects, owners and dependency relationships, retaining prerequisite ancestors when filtering.",
      "Do preserve camera position, selection and typed drafts through ordinary polling updates.",
      "Do keep English/Spanish labels, keyboard activation, visible focus and textual state cues.",
      "Do check native-scale entry and explicit Fit separately at desktop and phone sizes."
    ],
    "donts": [
      "Don't introduce brutalist framing, grid overlays, decorative rules or descriptive dashboard filler.",
      "Don't reduce completed-node opacity or use owner colour as the only identity signal.",
      "Don't auto-fit a populated graph when polling adds or removes tasks.",
      "Don't turn the inspector into a blocking modal or let outside clicks dismiss task editing.",
      "Don't hard-code agent names, schedule models or restore retired webhook UI.",
      "Don't describe Statistics or Connections as using the graph's cool palette."
    ]
  }
}
