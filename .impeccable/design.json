      "css": ".ds-workspace{--background:#f6f7f8;--foreground:#252a30;--surface:#ffffff;--surface-secondary:#eef0f2;--surface-tertiary:#e5e8ec;--muted:#626a74;--divider:#d9dee4;--accent:#35654e;--accent-foreground:#ffffff;--field-border:transparent;font-family:var(--font-geist-sans,Geist),sans-serif;color:var(--foreground)}@media(prefers-color-scheme:dark){.ds-workspace{--background:#191c20;--foreground:#e7e9ed;--surface:#24282e;--surface-secondary:#2d3239;--surface-tertiary:#383f48;--muted:#aab3bf;--divider:#414953;--accent:#9ec5ac;--accent-foreground:#17261d;}}.ds-camera{display:inline-flex;align-items:center;gap:4px;padding:4px;border-radius:12px;background:var(--surface);box-shadow:0 3px 15px #1a25340b}.ds-camera button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border:0;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;transition:transform 250ms ease,background-color 100ms cubic-bezier(0,0,.2,1);padding:0 12px;background:transparent;color:var(--foreground)}.ds-camera button:hover{background:var(--surface-secondary)}.ds-camera button:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.ds-camera button:active{transform:scale(.97)}.ds-camera span{font-size:12px;font-variant-numeric:tabular-nums}@media(prefers-reduced-motion:reduce){.ds-camera{transition:none;animation:none}}"
