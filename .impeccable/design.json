      "kind": "custom",
      "refersTo": "graph-node",
      "description": "Synthetic preview using the actual default assignee colour; production names and colours are dynamic.",
      "html": "<div class=\"ds-workspace\"><button class=\"ds-node\" aria-pressed=\"false\" aria-label=\"Example task · Example owner · Ready\"><span class=\"ds-node-title\">Example task</span><span class=\"ds-node-footer\"><span class=\"ds-node-owner\"><span class=\"ds-avatar\" aria-hidden=\"true\">E</span>Example owner</span><span class=\"ds-state\">Ready</span></span></button></div>",
      "css": ".ds-workspace{--background:#f6f7f8;--foreground:#252a30;--surface:#ffffff;--surface-secondary:#eef0f2;--surface-tertiary:#e5e8ec;--muted:#626a74;--divider:#d9dee4;--accent:#35654e;--accent-foreground:#ffffff;--field-border:transparent;font-family:var(--font-geist-sans,Geist),sans-serif;color:var(--foreground)}@media(prefers-color-scheme:dark){.ds-workspace{--background:#191c20;--foreground:#e7e9ed;--surface:#24282e;--surface-secondary:#2d3239;--surface-tertiary:#383f48;--muted:#aab3bf;--divider:#414953;--accent:#9ec5ac;--accent-foreground:#17261d;}}.ds-node{--assignee-color:#7297CA;display:flex;flex-direction:column;justify-content:space-between;align-items:stretch;gap:12px;width:244px;height:128px;padding:16px;border:0;border-radius:12px;text-align:left;color:var(--foreground);background:color-mix(in oklab,var(--assignee-color) 13%,var(--surface));box-shadow:0 3px 12px #1a25340a,0 1px 3px #1a253408;cursor:pointer;font-family:var(--font-geist-sans,Geist),sans-serif}.ds-node:hover{background:color-mix(in oklab,var(--assignee-color) 19%,var(--surface));box-shadow:0 5px 18px #1a253410}.ds-node:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.ds-node[aria-pressed=true]{outline:2px solid var(--accent);outline-offset:2px}.ds-node:active{transform:scale(.97)}.ds-node-title{font-size:14px;font-weight:500;line-height:20px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.ds-node-footer{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:11px;color:var(--muted)}.ds-node-owner{display:flex;align-items:center;gap:6px}.ds-avatar{display:flex;align-items:center;justify-content:center;width:20px;height:20px;border-radius:9999px;background:var(--surface-secondary);font-size:10px}.ds-state{color:var(--accent)}@media(prefers-reduced-motion:reduce){.ds-node{transition:none;animation:none}.ds-node-title{transition:none;animation:none}.ds-node-footer{transition:none;animation:none}.ds-node-owner{transition:none;animation:none}.ds-avatar{transition:none;animation:none}.ds-state{transition:none;animation:none}}"
    },
