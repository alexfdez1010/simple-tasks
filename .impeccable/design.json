  "components": [
    {
      "name": "Workspace primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "HeroUI primary styling with workspace height and radius overrides.",
      "html": "<div class=\"ds-workspace\"><button class=\"ds-button-primary\">New task</button></div>",
      "css": ".ds-workspace{--background:#f6f7f8;--foreground:#252a30;--surface:#ffffff;--surface-secondary:#eef0f2;--surface-tertiary:#e5e8ec;--muted:#626a74;--divider:#d9dee4;--accent:#35654e;--accent-foreground:#ffffff;--field-border:transparent;font-family:var(--font-geist-sans,Geist),sans-serif;color:var(--foreground)}@media(prefers-color-scheme:dark){.ds-workspace{--background:#191c20;--foreground:#e7e9ed;--surface:#24282e;--surface-secondary:#2d3239;--surface-tertiary:#383f48;--muted:#aab3bf;--divider:#414953;--accent:#9ec5ac;--accent-foreground:#17261d;}}.ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 16px;border:0;border-radius:8px;font-size:14px;font-weight:500;cursor:pointer;transition:transform 250ms ease,background-color 100ms cubic-bezier(0,0,.2,1);background:var(--accent);color:var(--accent-foreground)}.ds-button-primary:hover{background:color-mix(in oklab,var(--accent) 90%,var(--accent-foreground) 10%)}.ds-button-primary:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.ds-button-primary:active{transform:scale(.97)}.ds-button-primary:disabled{opacity:.5;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;animation:none}}"
    },
