      "html": "<div class=\"ds-workspace\"><nav class=\"ds-nav\" aria-label=\"Tasks\"><a href=\"#statistics\">Statistics</a><a href=\"#connections\">Connections</a></nav></div>",
      "css": ".ds-workspace{--background:#f6f7f8;--foreground:#252a30;--surface:#ffffff;--surface-secondary:#eef0f2;--surface-tertiary:#e5e8ec;--muted:#626a74;--divider:#d9dee4;--accent:#35654e;--accent-foreground:#ffffff;--field-border:transparent;font-family:var(--font-geist-sans,Geist),sans-serif;color:var(--foreground)}@media(prefers-color-scheme:dark){.ds-workspace{--background:#191c20;--foreground:#e7e9ed;--surface:#24282e;--surface-secondary:#2d3239;--surface-tertiary:#383f48;--muted:#aab3bf;--divider:#414953;--accent:#9ec5ac;--accent-foreground:#17261d;}}.ds-nav{display:flex;flex-wrap:wrap;align-items:center;gap:4px}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 12px;color:var(--foreground);font-size:14px;text-decoration:none}.ds-nav a:hover{text-decoration:underline}.ds-nav a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}@media(max-width:639px){.ds-nav{justify-content:space-between;gap:0}.ds-nav a{padding-inline:8px;font-size:12px}}@media(prefers-reduced-motion:reduce){.ds-nav{transition:none;animation:none}}"
