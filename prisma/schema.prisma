generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Status {
  id         String  @id @default(cuid())
  name       String  @unique
  color      String
  position   Int
  isTerminal Boolean @default(false)
  tasks      Task[]

  @@index([position])
}

model Task {
  id             String              @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  statusId       String
  position       Int
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  status         Status              @relation(fields: [statusId], references: [id], onDelete: Restrict)
  propertyValues TaskPropertyValue[]

  @@index([statusId, position])
  @@index([statusId, completedAt(sort: Desc)])
}

enum TaskPropertyType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
}

model TaskPropertyDefinition {
  id                String              @id @default(cuid())
  name              String              @unique
  type              TaskPropertyType
  position          Int
  options           Json                @default("[]")
  values            TaskPropertyValue[]
  measureStatistics StatisticWidget[]   @relation("StatisticMeasureProperty")
  groupStatistics   StatisticWidget[]   @relation("StatisticGroupProperty")
  dateStatistics    StatisticWidget[]   @relation("StatisticDateProperty")

  @@index([position])
}

model TaskPropertyValue {
  taskId     String
  propertyId String
  value      Json
  task       Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  property   TaskPropertyDefinition @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([taskId, propertyId])
  @@index([propertyId])
}

enum StatisticVisualization {
  KPI
  BAR
  DONUT
  LINE
}

enum StatisticMeasure {
  COUNT
  SUM
  AVERAGE
  MINIMUM
  MAXIMUM
  COMPLETION_RATE
  AVERAGE_RESOLUTION_TIME
  OVERDUE_COUNT
  ON_TIME_RATE
}

enum StatisticScope {
  ALL
  ACTIVE
  COMPLETED
}

enum StatisticGroupBy {
  NONE
  STATUS
  PROPERTY
  DATE
}

enum StatisticDateField {
  CREATED_AT
  UPDATED_AT
  DUE_DATE
  COMPLETED_AT
  PROPERTY
}

enum StatisticDateBucket {
  DAY
  WEEK
  MONTH
  QUARTER
  YEAR
}

enum StatisticDateRange {
  ALL_TIME
  TODAY
  LAST_7_DAYS
  LAST_30_DAYS
  LAST_90_DAYS
  THIS_WEEK
  THIS_MONTH
  THIS_QUARTER
  THIS_YEAR
  NEXT_7_DAYS
  NEXT_30_DAYS
}

model StatisticWidget {
  id                String                  @id @default(cuid())
  name              String
  visualization     StatisticVisualization
  measure           StatisticMeasure
  scope             StatisticScope          @default(ALL)
  groupBy           StatisticGroupBy        @default(NONE)
  measurePropertyId String?
  groupPropertyId   String?
  dateField         StatisticDateField?
  datePropertyId    String?
  dateBucket        StatisticDateBucket?
  dateRange         StatisticDateRange      @default(ALL_TIME)
  statusIds         Json                    @default("[]")
  position          Int
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  measureProperty   TaskPropertyDefinition? @relation("StatisticMeasureProperty", fields: [measurePropertyId], references: [id], onDelete: Cascade)
  groupProperty     TaskPropertyDefinition? @relation("StatisticGroupProperty", fields: [groupPropertyId], references: [id], onDelete: Cascade)
  dateProperty      TaskPropertyDefinition? @relation("StatisticDateProperty", fields: [datePropertyId], references: [id], onDelete: Cascade)

  @@index([position])
  @@index([measurePropertyId])
  @@index([groupPropertyId])
  @@index([datePropertyId])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
