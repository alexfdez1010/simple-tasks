generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model Status {
  id          String       @id @default(cuid())
  name        String       @unique
  color       String
  position    Int
  isTerminal  Boolean      @default(false)
  tasks       Task[]
  automations Automation[]

  @@index([position])
}

model Task {
  id             String              @id @default(cuid())
  title          String
  description    String?
  dueDate        DateTime?
  statusId       String
  position       Int
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  status         Status              @relation(fields: [statusId], references: [id], onDelete: Restrict)
  propertyValues TaskPropertyValue[]

  @@index([statusId, position])
  @@index([statusId, completedAt(sort: Desc)])
}

enum TaskPropertyType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
}

model TaskPropertyDefinition {
  id          String              @id @default(cuid())
  name        String              @unique
  type        TaskPropertyType
  position    Int
  options     Json                @default("[]")
  values      TaskPropertyValue[]
  automations Automation[]

  @@index([position])
}

enum AutomationActionType {
  SET_COMPLETION_DATE_TODAY
  SET_PROPERTY_VALUE
}

model Automation {
  id              String                  @id @default(cuid())
  name            String
  triggerStatusId String
  actionType      AutomationActionType
  propertyId      String?
  propertyValue   Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  triggerStatus   Status                  @relation(fields: [triggerStatusId], references: [id], onDelete: Cascade)
  property        TaskPropertyDefinition? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([triggerStatusId])
  @@index([propertyId])
}

model TaskPropertyValue {
  taskId     String
  propertyId String
  value      Json
  task       Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  property   TaskPropertyDefinition @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([taskId, propertyId])
  @@index([propertyId])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
